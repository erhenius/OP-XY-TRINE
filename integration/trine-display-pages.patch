+def bundle_page_claims(machines, page_count):
+    """Read reservations from the bundle that owns each selected machine."""
+    pages = set()
+    for machine in machines:
+        source = machine.root.resolve()
+        for folder in (source, *source.parents):
+            manifest = folder / 'machine-bundle.json'
+            if not manifest.is_file():
+                continue
+            bundle = document(manifest)
+            if bundle.get('id') != machine.id or Path(bundle.get('machine', '')) != source.relative_to(folder):
+                continue
+            for claim in bundle.get('claims', ()):
+                if claim.startswith('page:'):
+                    page = claim[5:]
+                    require(page.isascii() and page.isdecimal() and len(page) <= len(str(page_count))
+                            and int(page) < page_count, 'Invalid display page claim in ' + machine.id + ': ' + claim)
+                    pages.add(int(page))
+            break
+    return pages
+
+
+def trine_display_pages(profile, machines, layout):
+    """Internal Trine screens, after assigning persistent machine identities."""
+    rules = profile['identities']
+    used = {identity['page'] for identity in FIXED_NUMBERS.values()}
+    used.update(identity['page'] for identity in (layout or {}).values())
+    used.update(machine.identity['page'] for machine in machines)
+    used.update(bundle_page_claims(machines, rules['pages']))
+    # Use the relocatable page range, excluding the SDK's last-page overlay.
+    free = [page for page in range(rules['pages'] - 2, rules['page_none'], -1) if page not in used]
+    require(len(free) >= 2, 'Trine needs two free display pages in this layout')
+    return dict(zip(('setup', 'main'), free[:2]))
+
