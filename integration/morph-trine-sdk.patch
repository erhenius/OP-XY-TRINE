+void m3_receive(u32 base,u32 id,i32 value) {
+    using namespace m3_ui;
+    if (id != private_message) { stock<void(u32,u32,i32)>(0x8d50eb8c)(base,id,value); return; }
+    const u32 t = u32(value) >> setup_bits, settings = u32(value) & setup_mask;
+    if (t < tracks && valid_setup(settings)) audio[t] = settings;
+}
+u32 m3_step(u32 project,u32 track,u32 position) {
+    const u32 result = stock<u32(u32,u32,u32)>(0x8d5936c0)(project,track,position);
+    if (track < m3_ui::tracks) m3_ui::publish_track(m3_ui::active(),track);
+    return result;
+}
+u32 m3_project() {
+    using namespace m3_ui;
+    const u32 project = stock<u32()>(0x8d584210)();
+    if (project && project == pending_project) saved = pending;
+    else for (u32 i = 0; i < slots; ++i) saved.word[i] = initial_settings;
+    pending_project = menu_pattern = 0;
+    for (u32 t = 0; t < tracks; ++t) sent[t] = false;
+    refresh();
+    return project;
+}
+void m3_new() { m3_ui::pending_project = 0; m3_stock_new(); }
+void* m3_copy(void* dst, const void* src, u32 bytes) {
+    using namespace m3_ui;
+    const u32 to = reinterpret_cast<Address>(dst), from = reinterpret_cast<Address>(src);
+    if (bytes == pattern_bytes) {
+        const u32 project = active();
+        const int a = index_of(project, from), b = index_of(project, to);
+        const u32 setting = a >= 0 ? saved.word[a] : from == clipboard ? copied : initial_settings;
+        if (to == clipboard) copied = setting;
+        if (b >= 0) saved.word[b] = setting;
+    }
+    return stock<void*(void*,const void*,u32)>(0x040201c4)(dst,src,bytes);
+}
+// Companion callbacks execute on the GUI role. Restore is staged until stock
+// publishes the deserialized project buffer.
+extern "C" {
+unsigned m3_saved(unsigned) __asm__("m3_saved");
+void m3_loaded(unsigned, const opxy::u8*, unsigned) __asm__("m3_loaded");
+}
+unsigned m3_saved(unsigned i) { return i < m3_ui::slots ? m3_ui::saved.word[i] : 0; }
+void m3_loaded(unsigned project, const opxy::u8* bytes, unsigned width) {
+    m3_ui::pending_project = project;
+    for (unsigned i = 0; i < m3_ui::slots; ++i) {
+        unsigned word = 0;
+        if (!bytes || !width) word = m3_ui::initial_settings;
+        if (bytes && (width == 2 || width == 4))
+            for (unsigned j = 0; j < width; ++j)
+                word |= unsigned(bytes[i * width + j]) << (8 * j);
+        if (width == 2) word = m3_resonator::migrate_v1(word);
+        m3_ui::pending.word[i] = m3_resonator::valid_setup(word) ? word : 0;
+    }
+}
