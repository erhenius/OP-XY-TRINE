+int m3_setup_turn(u32 track,u32 index,u32 event) {
+    using namespace m3_ui;
+    if (index < 16 || index > 19 || !menu(track) || !plain()) return -1;
+    const int slot = index_of(active(), menu_pattern);
+    if (slot < 0 || !event) return 0;
+    return change(track,slot,edit(saved.word[slot], index-16, at<const i32>(event)[1]));
