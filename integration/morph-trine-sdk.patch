diff --git a/sdk/platform/opxy-1.2.1/m3_probe.cpp.in b/sdk/platform/opxy-1.2.1/m3_probe.cpp.in
new file mode 100644
index 0000000..2e59376
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/m3_probe.cpp.in
@@ -0,0 +1,154 @@
+// OS 1.2.1 instrument resonator. The stock filter registrar populates
+// the per-voice factory table and its name map, independently of send FX.
+#include "registration.hpp"
+// The FX build carrier has no separate authored source-unit slot.
+#include "resonator.cpp"
+
+using opxy::u32;
+using opxy::i32;
+using opxy::platform::Address;
+using opxy::platform::Record;
+using opxy::platform::at;
+using opxy::platform::stock;
+
+extern "C" {
+extern const char m3probe_fx_id[] __asm__("m3probe_fx_id");
+extern const char m3probe_fx_factory[] __asm__("m3probe_fx_factory");
+extern const char m3probe_fx_parameter_name[] __asm__("m3probe_fx_parameter_name");
+int m3probe_fx_register() __asm__("m3probe_fx_register");
+int m3probe_ready() __asm__("m3probe_ready");
+void m3probe_filter_init(u32, const char*, const char*, const char*, u32)
+    __asm__("m3probe_filter_init");
+}
+
+#include "m3_setup_ui.hpp"
+
+namespace {
+const Address kFilterRecords = 0x08039b2c;
+const u32 kRegisterFilter = 0x8d50673c;
+const u32 kStockSvf = 10;
+const u32 kStockSvfFactory = 0x8d51c058;
+const Address kStockSvfMethods = 0x8405307c;
+const u32 kStockVoiceCount = 128;
+const u32 kStockSlotBytes = 0x90;
+const unsigned kFilterControlOffset = 16;
+const u32 kProbeId = 11;
+const u32 kInstrumentFilterPage = 3;
+const u32 kRecordWords = 12;
+const u32 kNameBytes = 32;
+using m3_resonator::Mode;
+
+using Registrar = void(u32, const char*, const char*, const char*, u32);
+
+const volatile u32* row(u32 id) {
+    return at<const volatile u32>(kFilterRecords) + id * kRecordWords;
+}
+
+unsigned probe_id() { return reinterpret_cast<Address>(m3probe_fx_id); }
+
+bool name_matches(const volatile u32* record, const char* name, u32 size) {
+    const volatile char* field = reinterpret_cast<const volatile char*>(record + 4);
+    for (u32 i = 0; i < kNameBytes; ++i) {
+        if (field[i] != (i < size ? name[i] : 0)) return false;
+    }
+    return true;
+}
+
+bool empty(const volatile u32* record) {
+    for (u32 i = 0; i < kRecordWords; ++i) {
+        if (record[i] != 0) return false;
+    }
+    return true;
+}
+
+struct FilterObject {
+    const void* const* methods;
+    m3_resonator::Voice voice;
+};
+
+static_assert(sizeof(FilterObject) <= kStockSlotBytes, "Resonator exceeds stock filter slot");
+m3_resonator::Coefficients caches[2] = {};
+
+m3_resonator::Coefficients& cache_for(const FilterObject* object) {
+    return caches[static_cast<unsigned>(object->voice.mode)];
+}
+
+m3_resonator::Parameters read_controls(const i32* track) {
+    // The stock SVF consumes these same four M3 track words.
+    const i32* controls = track + kFilterControlOffset;
+    return {{controls[0], controls[1], controls[2], controls[3]}};
+}
+
+m3_resonator::Excitation voices[kStockVoiceCount];
+unsigned voice_slot(const FilterObject* o) {
+    return (reinterpret_cast<Address>(o) - 0x84c6239c) / kStockSlotBytes;
+}
+void audio_block(FilterObject* o, i32* block, const i32* track, i32 key, bool stereo) {
+    const unsigned slot = voice_slot(o);
+    if (slot >= kStockVoiceCount) return;
+    const Address offset = reinterpret_cast<Address>(track) - 0x84eab39c;
+    const unsigned track_number = offset / 0xe8;
+    const unsigned word = track_number < 8 && offset % 0xe8 == 0 ? m3_ui::audio[track_number] : 0;
+    m3_resonator::perform(o->voice, cache_for(o), read_controls(track), block, voices[slot],
+                          m3_resonator::unpack(word), stereo, m3_resonator::played_note(key));
+}
+void mono(FilterObject* o, i32* block, const i32* track, i32 key, i32) { audio_block(o, block, track, key, false); }
+void stereo(FilterObject* o, i32* block, const i32* track, i32 key, i32) { audio_block(o, block, track, key, true); }
+void reset(FilterObject* o, u32) {
+    const unsigned slot = voice_slot(o);
+    if (slot < kStockVoiceCount) voices[slot] = {};
+    m3_resonator::reset(o->voice);
+}
+
+// Retain the stock SVF's untouched entries. Only the voice processing and
+// reset entries use the new state in the same pool slot.
+const void* const kResonatorMethods[10] = {
+    reinterpret_cast<const void*>(0x8d51c0c2), reinterpret_cast<const void*>(0x8d51c0d8),
+    reinterpret_cast<const void*>(&mono), reinterpret_cast<const void*>(&stereo),
+    reinterpret_cast<const void*>(0x8d5006a4), reinterpret_cast<const void*>(&reset),
+    reinterpret_cast<const void*>(0x8d51bc20), reinterpret_cast<const void*>(0x8d500684),
+    nullptr, nullptr
+};
+
+void* resonator_factory(u32 index, u32 track) {
+    if (index >= kStockVoiceCount) return nullptr;
+    auto object = stock<FilterObject*(u32, u32)>(kStockSvfFactory)(index, track);
+    if (object && object->methods == at<const void* const>(kStockSvfMethods)) {
+        object->methods = kResonatorMethods;
+        reset(object, 0);
+    }
+    return object;
+}
+
+const char kFilterName[] = "trine";
+}
+
+int m3probe_ready() {
+    const volatile u32* svf = row(kStockSvf);
+    const volatile u32* probe = row(kProbeId);
+    return probe_id() == kProbeId && svf[0] == kStockSvfFactory &&
+           probe[0] == reinterpret_cast<Address>(resonator_factory) &&
+           probe[1] == reinterpret_cast<Address>(m3probe_fx_parameter_name) &&
+           probe[3] == svf[3] && name_matches(probe, kFilterName, sizeof(kFilterName)-1);
+}
+
+int m3probe_fx_register() {
+    if (probe_id() != kProbeId) return 0;
+    const Record record = {m3probe_fx_factory, m3probe_fx_parameter_name, kFilterName,
+                           m3probe_fx_id, at<const char>(kInstrumentFilterPage), 0};
+    return sdk_register_effect(&record) > 0;
+}
+
+void m3probe_filter_init(u32 id, const char* name, const char* factory,
+                         const char* parameters, u32 page) {
+    const auto register_filter = stock<Registrar>(kRegisterFilter);
+    // Reproduce the final stock registration (Dynamic) with its original ABI.
+    register_filter(id, name, factory, parameters, page);
+    const volatile u32* svf = row(kStockSvf);
+    if (probe_id() != kProbeId || svf[0] != kStockSvfFactory ||
+        !name_matches(svf, "svf", 3)) return;
+    if (empty(row(kProbeId))) {
+        register_filter(kProbeId, kFilterName, reinterpret_cast<const char*>(resonator_factory),
+                        m3probe_fx_parameter_name, svf[3]);
+    }
+}
diff --git a/sdk/platform/opxy-1.2.1/m3_setup_ui.hpp b/sdk/platform/opxy-1.2.1/m3_setup_ui.hpp
new file mode 100644
index 0000000..4561128
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/m3_setup_ui.hpp
@@ -0,0 +1,361 @@
+// Included in the generated registration translation unit for this isolated build.
+#include "screen.hpp"
+#include "resonator.hpp"
+#include "sweep_display.hpp"
+namespace m3_ui {
+using namespace opxy;
+using namespace opxy::platform;
+using namespace m3_resonator;
+constexpr u32 tracks = 8, patterns = 16, slots = tracks * patterns;
+constexpr u32 pattern_bytes = 0x53f4, track_bytes = 0x53f44;
+constexpr u32 clipboard = 0x84ffd208, private_message = 128;
+constexpr u32 setup_page = 82, main_page = 83;
+constexpr u32 initial_settings = unsigned(Exciter::Pulse);
+struct Settings { u32 word[slots]; };
+Settings saved, pending;
+u32 pending_project, menu_pattern, last_sent[tracks];
+u32 render_page;
+bool sent[tracks];
+u32 copied;
+u32 audio[tracks];
+u32 active() { return word(0x840a0524); }
+u32 pattern_for(u32 t) { return stock<u32(u32)>(0x8d587708)(t); }
+int index_of(u32 project, u32 pointer) {
+    if (!project || pointer < project + 0xd7c) return -1;
+    const u32 offset = pointer - project - 0xd7c;
+    if (offset >= tracks * track_bytes) return -1;
+    const u32 track = offset / track_bytes, within = offset % track_bytes;
+    if (within % pattern_bytes || within >= patterns * pattern_bytes) return -1;
+    return int(track * patterns + within / pattern_bytes);
+}
+bool context(u32 track) {
+    if (track >= tracks || track != byte(kSelectedTrack) || word(0x080238bc) != 2 || word(kScreen) != 0) return false;
+    auto controller = stock<const u32*()>(0x8c0944b0)();
+    return controller && *controller == 0x8400dff8 && stock<u32(u32)>(0x8d5878d4)(track) == 11;
+}
+bool plain() { return !stock<u32(u32)>(0x8d5b7d7c)(14u + byte(kSelectedTrack)) && !shift_held() && !stock<u32()>(0x8d5b7e34)(); }
+void send(u32 track, u32 value) {
+    if (!sent[track] || last_sent[track] != value) {
+        stock<void(u32,i32)>(0x8d4dc84c)(private_message, i32((track << setup_bits) | value));
+        sent[track] = true;
+        last_sent[track] = value;
+    }
+}
+void publish_track(u32 project,u32 track) {
+    const u32 playing = stock<u32(u32)>(0x8d586014)(track);
+    const int slot = index_of(project, playing);
+    if (slot >= 0) send(track, saved.word[slot]);
+}
+void refresh() {
+    const u32 project = active();
+    if (!project || word(0x840a0528)) return;
+    for (u32 t = 0; t < tracks; ++t) publish_track(project,t);
+}
+bool menu(u32 t) {
+    if (menu_pattern && (!context(t) || menu_pattern != pattern_for(t))) menu_pattern = 0;
+    return menu_pattern != 0;
+}
+namespace {
+using namespace opxy::screen;
+void number(char* out, unsigned value, const char* suffix) {
+    if (value >= 10000) *out++ = char('0' + value / 10000);
+    if (value >= 1000) *out++ = char('0' + value / 1000 % 10);
+    if (value >= 100) *out++ = char('0' + value / 100 % 10);
+    if (value >= 10) *out++ = char('0' + value / 10 % 10);
+    *out++ = char('0' + value % 10);
+    do { *out++ = *suffix; } while (*suffix++);
+}
+void interval(char* out, int value) {
+    if (value > 0) *out++ = '+';
+    if (value < 0) *out++ = '-';
+    number(out, unsigned(value < 0 ? -value : value), "");
+}
+void write_text(Leaf* node, const char* value) {
+    if (node) opxy::screen::set_text(node,value);
+}
+
+struct Renderer {
+    struct Object {
+        Base base;
+        u32 shown;
+        Leaf *first, *second, *routing, *placement;
+        PathNode* icons[5];
+        PathNode* blend;
+        u16 shades[19];
+        u16 padding;
+    };
+    static void init(Object* o) {
+        clear(o);
+        o->shown = ~0u;
+        if (!o->base.svg) return;
+        o->first = text_node(find(&o->base,"first"));
+        o->second = text_node(find(&o->base,"second"));
+        o->routing = text_node(find(&o->base,"routing"));
+        o->placement = text_node(find(&o->base,"placement"));
+        o->blend = path_node(find(&o->base,"blend"));
+        char id[] = "icon0";
+        for (u32 i = 0; i < 5; ++i) {
+            id[4] = char('0' + i);
+            o->icons[i] = path_node(find(&o->base,id));
+        }
+        for (u32 i = 0; i < 19; ++i) {
+            char name[10] = "shade";
+            number(name + 5,i,"");
+            auto donor = path_node(find(&o->base,name));
+            if (donor) o->shades[i] = donor->fill;
+        }
+    }
+    static void shade(PathNode* p, u16 id) {
+        if (p && id && p->fill != id) {
+            set_fill(p,id);
+            invalidate(p);
+        }
+    }
+    static void frame(Object* o, i32) {
+        if (render_page != setup_page || !o->base.svg) return;
+        const int slot = index_of(active(),menu_pattern);
+        if (slot < 0) return;
+        const u32 value = saved.word[slot];
+        if (o->shown != value) {
+            const Setup s = unpack(value);
+            char first[5], second[5];
+            interval(first,s.interval1);
+            interval(second,s.interval2);
+            write_text(o->first,first);
+            write_text(o->second,second);
+            write_text(o->routing,s.mode == Mode::Wide ? "Wide" : "Bypass");
+            write_text(o->placement,s.whole ? "Whole" : "Resonator");
+            for (u32 i = 0; i < 5; ++i)
+                shade(o->icons[i],o->shades[unsigned(s.exciter) == i + unsigned(Exciter::Pulse)]);
+            shade(o->blend,o->shades[2 + (s.blend * 16 + 50) / 100]);
+            o->shown = value;
+        }
+        draw(&o->base);
+    }
+};
+
+struct MainRenderer {
+    struct Object {
+        Base base;
+        PathNode *response, *badge;
+        Leaf *q, *duration, *type;
+        u32 shown;
+        i32 current[4];
+    };
+    static void init(Object* o) {
+        clear(o);
+        if (!o->base.svg) return;
+        o->response = path_node(find(&o->base,"sweep_curve"));
+        o->badge = path_node(find(&o->base,"badge"));
+        o->q = text_node(find(&o->base,"q"));
+        o->duration = text_node(find(&o->base,"duration"));
+        o->type = text_node(find(&o->base,"type"));
+        if (o->q) anchor_middle(o->q);
+    }
+    static void position(Leaf* node, i32 x, i32 y) {
+        const u32 at[] = {6,7};
+        const i32 values[] = {x * 1024,y * 1024};
+        if (node) set_words(node,at,values);
+    }
+    static void update_curve(Object* o) {
+        PathNode* curve = o->response;
+        if (!curve) return;
+        const Vector& v = curve->commands;
+        constexpr u32 points = m3_display::curve_points;
+        if (!ordered(v) || (v.begin & 3) || v.end - v.begin != sizeof(Command) * (points + 3)) return;
+        auto* commands = reinterpret_cast<Command*>(v.begin);
+        if (commands[0].type != 1 || commands[points + 2].type != 5) return;
+        for (u32 i = 1; i <= points + 1; ++i)
+            if (commands[i].type != 2) return;
+        i32 y[points];
+        m3_display::sweep_pixels(o->current[0],o->current[1],o->current[2],y);
+        for (u32 i = 0; i < points; ++i) commands[i + 1].y = y[i] * 1024;
+        invalidate(curve);
+
+        // Anchor at the resonant frequency, interpolating on the same polygon.
+        const u32 f = m3_display::interpolate(m3_display::frequency_table,m3_display::normalized(o->current[0]),6);
+        u32 i = 0;
+        while (i + 2 < points && m3_display::plot_frequency[i+1] < f) ++i;
+        const u32 lo = m3_display::plot_frequency[i], hi = m3_display::plot_frequency[i+1];
+        const i32 mix = f <= lo ? 0 : i32((f-lo)*256u/(hi-lo));
+        const i32 left = commands[i+1].x / 1024, right = commands[i+2].x / 1024;
+        const i32 x = bounded(left + (right-left)*mix/256,51,429);
+        const i32 top = bounded(y[i] + (y[i+1]-y[i])*mix/256 + 3,62,139);
+        if (o->badge) position(&o->badge->leaf,x,top);
+        position(o->q,x,top+20);
+    }
+    static void frame(Object* o, i32) {
+        if (render_page != main_page || !o->base.svg) return;
+        const u32 t = platform::byte(platform::kSelectedTrack);
+        u32 changed = o->shown ? 0 : 15;
+        for (u32 i = 0; i < 4; ++i) {
+            const i32 value = stock<i32(u32,u32,u32,u32)>(0x8d5ac9dc)(0x86bd027c,t,16+i,1);
+            if (value != o->current[i]) changed |= 1u << i;
+            o->current[i] = value;
+        }
+        if (changed & 7) update_curve(o);
+        if (changed & 2) {
