@@ -0,0 +1,54 @@
+"""Verified Blackfin arithmetic objects for the pinned cross-compiler."""
+import fcntl
+import os
+from pathlib import Path
+import tempfile
+import zipfile
+
+from . import runtime
+from .formats import require, sha
+from .pipeline import toolchains
+
+
+def read_archive(path, expected):
+    if path.is_file() and path.stat().st_size <= 16 * 1024 * 1024:
+        data = path.read_bytes()
+        if sha(data) == expected:
+            return data
+    return None
+
+
+def for_mac(compiler):
+    from .native import file_hash
+    from .toolchain import download
+
+    release = toolchains()['hosts']['windows-x86_64']
+    expected = release['compiler'][runtime.ARCHIVE]
+    record = release['download']
+    local = read_archive(compiler.parent.parent / runtime.ARCHIVE, expected)
+    if local is not None:
+        return local
+    workspace = Path(os.environ.get('XY_MANAGER_HOME', '~/Documents/OP-XY Manager')).expanduser()
+    cache = workspace / 'machine-library' / 'target-runtime' / expected
+    cache.mkdir(parents=True, exist_ok=True)
+    with (cache / 'fetch.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        target = cache / 'libgcc.a'
+        data = read_archive(target, expected)
+        if data is not None:
+            return data
+        with tempfile.TemporaryDirectory(dir=cache) as temp:
+            temp = Path(temp)
+            package = temp / 'toolchain.zip'
+            print('Fetching the SDK-pinned Blackfin arithmetic library for this build.', flush=True)
+            download(record['url'], package)
+            require(file_hash(package) == record['sha256'], 'Blackfin toolchain ZIP checksum mismatch')
+            with zipfile.ZipFile(package) as archive:
+                member = archive.getinfo(record['folder'] + '/' + runtime.ARCHIVE)
+                require(0 < member.file_size <= 16 * 1024 * 1024, 'Invalid Blackfin runtime size')
+                data = archive.read(member)
+            require(sha(data) == expected, 'Blackfin arithmetic library checksum mismatch')
+            staged = temp / 'libgcc.a'
+            staged.write_bytes(data)
+            staged.replace(target)
+            return data
